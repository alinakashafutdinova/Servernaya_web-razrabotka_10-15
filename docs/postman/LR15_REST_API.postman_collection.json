        {
          "name": "POST /api/articles",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/articles",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"ЛР15: статья через API\",\n  \"summary\": \"Проверяем запросы к серверному приложению через REST API.\",\n  \"content\": \"Текст тестовой публикации для курсового проекта.\",\n  \"published_at\": \"2026-11-20\",\n  \"is_published\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\",()=>pm.response.to.have.status(201));",
                  "if(pm.response.code===201){pm.collectionVariables.set(\"article_id\",pm.response.json().data.id);}"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /api/articles/{id}",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/api/articles/{{article_id}}",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Заголовок изменён через PATCH\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\",()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT /api/articles/{id}",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/articles/{{article_id}}",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"ЛР15: полное изменение через PUT\",\n  \"summary\": \"Проверяем запросы к серверному приложению через REST API.\",\n  \"content\": \"Текст тестовой публикации для курсового проекта.\",\n  \"published_at\": \"2026-11-20\",\n  \"is_published\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\",()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /api/articles/{id}",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/articles/{{article_id}}",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"204\",()=>pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 · Выход",
      "item": [
        {
          "name": "POST /api/logout",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/logout",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\",()=>pm.response.to.have.status(200));",
                  "if(pm.response.code===200){pm.collectionVariables.unset(\"token\");}"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "article_id",
      "value": "1"
    },
    {
      "key": "moderator_email",
      "value": "moderator@example.test"
    },
    {
      "key": "moderator_password",
      "value": ""
    }
  ]
}
