APP_NAME="Курсовой проект · Лабораторные №10–15"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=ru
APP_TIMEZONE=Europe/Moscow
APP_KEY=
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database
DB_QUEUE=default
MODERATOR_EMAIL=moderator@example.test
MODERATOR_PASSWORD=
MAIL_MAILER=log
MAIL_FROM_ADDRESS=demo@example.test
MAIL_FROM_NAME="Курсовой проект"

# Настоящие письма необязательны: настройте SMTP только в своём .env
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.mail.ru
# MAIL_PORT=587
# MAIL_USERNAME=you@mail.ru
# MAIL_PASSWORD=application-password
# MAIL_FROM_ADDRESS=you@mail.ru
