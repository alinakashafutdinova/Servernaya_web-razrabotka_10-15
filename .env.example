APP_NAME="Курсовой проект · Лабораторные работы №10–15"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.ru
APP_KEY=
APP_LOCALE=ru
APP_TIMEZONE=Europe/Moscow

LOG_CHANNEL=stack
LOG_LEVEL=warning
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
# InfinityFree не поддерживает постоянно запущенный php artisan queue:work.

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_db_user
DB_PASSWORD=change_me

MODERATOR_EMAIL=moderator@example.ru
MODERATOR_PASSWORD=

MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp.mail.ru
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Курсовой проект · Лабораторные работы №10–15"
# ЛР №11. Ключ Pusher публичен, App Secret должен оставаться только в .env.
# Для настоящих уведомлений укажите все значения и включите pusher.
BROADCAST_CONNECTION=log
BROADCAST_DRIVER=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu
# После подключения Pusher: BROADCAST_CONNECTION=pusher
# QUEUE_CONNECTION=sync сохраняется на InfinityFree.
