APP_NAME="Курсовой проект · Лабораторные №10–15"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=ru
APP_TIMEZONE=Europe/Moscow
APP_KEY=
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=sqlite
SESSION_DRIVER=file
CACHE_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE=default
MODERATOR_EMAIL=moderator@example.test
MODERATOR_PASSWORD=
MAIL_MAILER=log
MAIL_FROM_ADDRESS=demo@example.test
MAIL_FROM_NAME="Курсовой проект"

# Настоящие письма необязательны: настройте SMTP только в своём .env
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.mail.ru
# MAIL_PORT=587
# MAIL_USERNAME=you@mail.ru
# MAIL_PASSWORD=application-password
# MAIL_FROM_ADDRESS=you@mail.ru
# ЛР №11: без ключей Pusher сайт и очередь работают, но live-события
# выводятся в log; для уведомлений в браузере нужен аккаунт Pusher.
BROADCAST_CONNECTION=log
BROADCAST_DRIVER=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu
# Для включения: BROADCAST_CONNECTION=pusher и ключи Pusher в .env

# ЛР №14: учебный режим — schedule:run отправляет отчёт сразу при первом
# запуске за день. Чтобы отправить ещё раз, используйте --force.
DAILY_REPORT_DEMO_EVERY_MINUTE=true
